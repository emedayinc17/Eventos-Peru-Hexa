# Example .env for contratacion-service (safe to commit)
# Replace placeholders with real secrets for local testing or use Vault in production.

# Database
DB_USER=app_contratacion
DB_PASS=change_me
DB_NAME=ev_contratacion
DB_HOST=localhost
DB_PORT=3306

# Application
APP_ENV=dev
SERVICE_NAME=contratacion-service
APP_HOST=0.0.0.0
APP_PORT=8040

# JWT / Auth
JWT_SECRET=dev-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_EXPIRES_MIN=60

# Internal tokens / service-to-service auth
INTERNAL_SERVICE_TOKEN=dev-internal-token-change-in-production

# Service URLs (local)
PROVEEDORES_SERVICE_URL=http://127.0.0.1:8030/proveedores
CATALOGO_SERVICE_URL=http://127.0.0.1:8020/catalogo
CONTRATACION_SERVICE_URL=http://127.0.0.1:8040/contratacion

# Vault (disabled for local development)
VAULT_ENABLED=false
VAULT_ADDR=
VAULT_TOKEN=

# CORS (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
